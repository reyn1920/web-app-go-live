{
  "venvPath": ".",
  "venv": "",
  "pythonVersion": "3.11",
  "typeCheckingMode": "standard",
  "reportMissingTypeStubs": "none",
  "reportUnknownMemberType": "warning",
  "reportUnknownVariableType": "warning",
  "exclude": [
    "**/.venv",
    "**/venv",
    "**/.mypy_cache",
    "**/.ruff_cache",
    "**/__pycache__"
  ]
}
